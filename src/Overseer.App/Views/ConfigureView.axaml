<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Overseer.App.ViewModels"
             x:Class="Overseer.App.Views.ConfigureView"
             x:DataType="vm:ConfigureViewModel">
  <ScrollViewer>
    <StackPanel Margin="14,10,14,16">
      <TextBlock Text="The parts of Claude Code that are fiddly to edit by hand: permission rules, hooks, instructions (CLAUDE.md), agents and commands."
                 Classes="muted wrap" Margin="6,0,6,6" />

      <Grid ColumnDefinitions="*,*" Margin="-7,0">
        <StackPanel>
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Shield}" Width="12" Height="12" Foreground="{DynamicResource Accent}" /></Border>
                <TextBlock Text="Permission rules" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding RuleGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuleGroupVM">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Classes="label" />
                      <TextBlock Text="{Binding Hint}" Classes="faint wrap" Margin="0,0,0,8" />
                      <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <DockPanel Margin="0,0,0,4">
                              <Button DockPanel.Dock="Right" Classes="link" Margin="0" Padding="6,2" AutomationProperties.Name="Remove rule"
                                      Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" Foreground="{DynamicResource Muted}" />
                              </Button>
                              <TextBlock Text="{Binding}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding NewRule}" Watermark="e.g. Bash(npm test:*)" AutomationProperties.Name="{Binding Title}" />
                      </DockPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Plug}" Width="12" Height="12" Foreground="{DynamicResource Teal}" /></Border>
                <TextBlock Text="Hooks" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Hooks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HookRowVM">
                    <DockPanel Margin="0,0,0,8">
                      <Button DockPanel.Dock="Right" Classes="danger" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Top"
                              Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveHookCommand}" CommandParameter="{Binding}" />
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Event}" FontWeight="SemiBold" FontSize="12.5" />
                          <TextBlock Text="{Binding Matcher}" Classes="faint" />
                          <TextBlock Text="Overseer" IsVisible="{Binding IsOverseer}" FontSize="11" Foreground="{DynamicResource Accent2}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Command}" Classes="mono faint trim" ToolTip.Tip="{Binding Command}" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Overseer's own hooks are switched on and off in Settings → Live data." Classes="faint wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.File}" Width="12" Height="12" Foreground="{DynamicResource Accent2}" /></Border>
                <TextBlock Text="Instructions (CLAUDE.md)" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ComboBox ItemsSource="{Binding MemoryFiles}" SelectedItem="{Binding MemoryFile}" HorizontalAlignment="Stretch" AutomationProperties.Name="Instructions file" />
              <TextBox Text="{Binding MemoryText}" AcceptsReturn="True" TextWrapping="Wrap" Height="300" Margin="0,10,0,8"
                       FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" AutomationProperties.Name="Instructions text" />
              <WrapPanel>
                <Button Classes="primary" Content="Save" Command="{Binding SaveMemoryCommand}" IsEnabled="{Binding MemoryDirty}" />
                <Button Content="Revert" Command="{Binding RevertMemoryCommand}" IsEnabled="{Binding MemoryDirty}" />
                <Button Content="Open in editor" Command="{Binding OpenMemoryCommand}" />
              </WrapPanel>
              <TextBlock Text="Saving keeps the previous version next to it as CLAUDE.md.overseer-backup." Classes="faint wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Robot}" Width="12" Height="12" Foreground="{DynamicResource Purple}" /></Border>
                <TextBlock Text="Agents (~/.claude/agents)" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Agents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MdItemVM">
                    <DockPanel Margin="0,0,0,8">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Open" Margin="8,0,0,0" Command="{ReflectionBinding $parent[UserControl].DataContext.OpenItemCommand}" CommandParameter="{Binding}" />
                        <Button Classes="danger" Content="Trash" Margin="8,0,0,0" Command="{ReflectionBinding $parent[UserControl].DataContext.TrashItemCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="{Binding Description}" Classes="faint trim" /></StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Create" Command="{Binding CreateAgentCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding NewAgentName}" Watermark="new-agent-name" AutomationProperties.Name="New agent name" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Terminal}" Width="12" Height="12" Foreground="{DynamicResource Blue}" /></Border>
                <TextBlock Text="Slash commands (~/.claude/commands)" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Commands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MdItemVM">
                    <DockPanel Margin="0,0,0,8">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Open" Margin="8,0,0,0" Command="{ReflectionBinding $parent[UserControl].DataContext.OpenItemCommand}" CommandParameter="{Binding}" />
                        <Button Classes="danger" Content="Trash" Margin="8,0,0,0" Command="{ReflectionBinding $parent[UserControl].DataContext.TrashItemCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Classes="mono" /><TextBlock Text="{Binding Description}" Classes="faint trim" /></StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Create" Command="{Binding CreateCommandCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding NewCommandName}" Watermark="new-command-name" AutomationProperties.Name="New command name" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
