<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Overseer.App.ViewModels"
             x:Class="Overseer.App.Views.SessionView"
             x:DataType="vm:SessionDetailViewModel">
  <Grid ColumnDefinitions="*,300">

    <!-- ===== main column: what needs you, what's happening, the log ===== -->
    <ScrollViewer>
      <StackPanel Margin="16,14,16,16" Spacing="12">

        <!-- a permission request you can answer here (A = allow once, D = deny) -->
        <Panel x:Name="PermissionHost" IsVisible="{Binding HasPending}">
        <Border x:Name="PermissionCard" Classes="need" Focusable="True" KeyDown="OnPermissionKey"
                DataContext="{Binding Pending}" x:DataType="vm:PendingVM" AutomationProperties.Name="Permission request">
          <StackPanel Spacing="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding AskedAgo, StringFormat='asked {0} ago'}" Classes="faint" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" Classes="pulse" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Ask, StringFormat='Claude {0}'}" FontWeight="SemiBold" />
              </StackPanel>
            </DockPanel>
            <Border Classes="code" Padding="10,8"><SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" /></Border>
            <TextBlock IsVisible="{Binding HasReason}" Text="{Binding Reason, StringFormat='Reason given: {0}'}" FontSize="12.5" Foreground="{DynamicResource Fg2}" Classes="wrap" />

            <StackPanel IsVisible="{Binding DenyOpen}" Spacing="6">
              <TextBlock Text="Tell Claude what to do instead (optional)" Classes="h2" />
              <TextBox x:Name="DenyBox" Text="{Binding DenyNote}" Watermark="e.g. run only the settings tests" AutomationProperties.Name="Tell Claude what to do instead">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{ReflectionBinding $parent[Window].DataContext.DenyCommand}" CommandParameter="{Binding}" />
                </TextBox.KeyBindings>
              </TextBox>
              <StackPanel Orientation="Horizontal">
                <Button Classes="primary" Content="Deny and send" Command="{ReflectionBinding $parent[Window].DataContext.DenyCommand}" CommandParameter="{Binding}" />
                <Button Content="Back" Command="{ReflectionBinding $parent[Window].DataContext.CancelDenyCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </StackPanel>

            <WrapPanel IsVisible="{Binding ShowButtons}">
              <Button Classes="primary" Command="{ReflectionBinding $parent[Window].DataContext.AllowOnceCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Allow once" /><TextBlock Text="A" Opacity="0.6" FontSize="11" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Command="{ReflectionBinding $parent[Window].DataContext.AllowAlwaysCommand}" CommandParameter="{Binding}" ToolTip.Tip="Claude Code adds this rule to the settings file you pick">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Always allow" /><TextBlock Text="{Binding RuleText}" Classes="mono" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" /></StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,6">
                <TextBlock Text="saved to" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Scopes}" SelectedIndex="{Binding AlwaysScope}" AutomationProperties.Name="Where to save the rule" />
              </StackPanel>
              <Button Command="{ReflectionBinding $parent[Window].DataContext.OpenDenyCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Deny…" /><TextBlock Text="D" Opacity="0.6" FontSize="11" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock Text="This prompt reached Overseer through its permission hook. If you don't answer here in time, Claude Code asks in the terminal as usual. This project = .claude/settings.local.json; all projects = ~/.claude/settings.json."
                       Classes="faint wrap" />
          </StackPanel>
        </Border>
        </Panel>

        <!-- what is happening now -->
        <Border Classes="pane" Padding="12,10" IsVisible="{Binding ShowNow}">
          <Grid ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,1,12,0">
              <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Foreground="{Binding StateInk}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding HeroHead}" FontWeight="SemiBold" Classes="trim" />
              <TextBlock Text="{Binding HeroDetail}" Foreground="{DynamicResource Fg2}" FontSize="12.5" Classes="wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
              <TextBlock Text="{Binding SourceNote}" Classes="faint" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- log -->
        <Border Classes="pane" IsVisible="{Binding !ShowConversation}">
          <StackPanel>
            <Border Classes="paneHead">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Read the conversation" Command="{Binding LoadConversationCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" Margin="0,0,12,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource Blue}" VerticalAlignment="Center" /><TextBlock Text="tool" FontSize="11.5" Foreground="{DynamicResource Fg2}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" /><TextBlock Text="you" FontSize="11.5" Foreground="{DynamicResource Fg2}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource Green}" VerticalAlignment="Center" /><TextBlock Text="Claude" FontSize="11.5" Foreground="{DynamicResource Fg2}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource Red}" VerticalAlignment="Center" /><TextBlock Text="error" FontSize="11.5" Foreground="{DynamicResource Fg2}" /></StackPanel>
                </StackPanel>
                <TextBlock Text="Log · newest first" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Timeline}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimelineItemVM">
                  <StackPanel>
                    <TextBlock Text="{Binding DayHeader}" IsVisible="{Binding HasDayHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Muted}" Margin="12,8,0,4" />
                    <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="12,0" MinHeight="32">
                      <Grid ColumnDefinitions="64,22,*" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}" Classes="mono" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <PathIcon Grid.Column="1" Data="{Binding Icon}" Foreground="{Binding Brush}" Width="11" Height="11" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,7">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Foreground="{DynamicResource Fg2}" Classes="trim" Classes.mono="{Binding Mono}"
                                     MaxWidth="640" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- conversation -->
        <Border Classes="pane" IsVisible="{Binding ShowConversation}">
          <StackPanel>
            <Border Classes="paneHead">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Back to the log" Command="{Binding HideConversationCommand}" />
                <TextBlock Text="Conversation" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Conversation}" Margin="12,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationVM">
                  <Border BorderBrush="{Binding Brush}" BorderThickness="2,0,0,0" Padding="10,2,4,2" Margin="0,0,0,10">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Who}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="{Binding Time}" Classes="mono" Foreground="{DynamicResource Muted}" />
                      </StackPanel>
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Margin="0,3,0,0" Foreground="{DynamicResource Fg2}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== inspector ===== -->
    <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel>
          <Border Classes="section">
            <StackPanel Spacing="4">
              <TextBlock Text="Details" Classes="h2" Margin="0,0,0,4" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="Project" Foreground="{DynamicResource Muted}" Margin="0,0,12,4" />
                <TextBlock Grid.Column="1" Text="{Binding Project}" HorizontalAlignment="Right" Classes="trim" ToolTip.Tip="{Binding Cwd}" />
                <TextBlock Grid.Row="1" Text="Model" Foreground="{DynamicResource Muted}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelName}" HorizontalAlignment="Right" ToolTip.Tip="{Binding ModelId}" />
                <TextBlock Grid.Row="2" Text="Started" Foreground="{DynamicResource Muted}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Started}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="3" Text="Ran for" Foreground="{DynamicResource Muted}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Elapsed}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="4" Text="Tokens" Foreground="{DynamicResource Muted}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalTokens}" HorizontalAlignment="Right" ToolTip.Tip="{Binding CostText}" />
                <TextBlock Grid.Row="5" Text="Tool calls · errors" Foreground="{DynamicResource Muted}" Margin="0,0,12,4" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                  <TextBlock Text="{Binding ToolCalls}" />
                  <TextBlock Text="·" Foreground="{DynamicResource Muted}" />
                  <TextBlock Text="{Binding Errors}" Foreground="{Binding ErrorsBrush}" />
                </StackPanel>
              </Grid>
              <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ContextLeft}" FontSize="12" Foreground="{DynamicResource Fg2}" />
                <TextBlock Text="{Binding ContextPercent, StringFormat='Context {0}'}" Foreground="{DynamicResource Muted}" />
              </DockPanel>
              <ProgressBar Classes="bar" Height="6" MinHeight="6" Value="{Binding ContextFraction}" Foreground="{Binding ContextBrush}" />
              <TextBlock Text="{Binding ContextSource}" Classes="faint" />
            </StackPanel>
          </Border>

          <Border Classes="section">
            <StackPanel>
              <TextBlock Text="Actions" Classes="h2" Margin="0,0,0,8" />
              <Button Content="Resume in terminal" Command="{Binding ResumeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6" />
              <Button Content="Open in Claude desktop app" Command="{Binding OpenDesktopCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6" />
              <Grid ColumnDefinitions="*,6,Auto" Margin="0,0,0,6">
                <ComboBox ItemsSource="{Binding ForkModels}" SelectedItem="{Binding ForkModel}" HorizontalAlignment="Stretch" AutomationProperties.Name="Model for the copy" />
                <Button Grid.Column="2" Content="Continue as copy" Command="{Binding ForkCopyCommand}" Margin="0"
                        ToolTip.Tip="Opens a terminal with a copy of this conversation (--fork-session) on the model you pick. The original is untouched." />
              </Grid>
              <Grid ColumnDefinitions="*,6,*" Margin="0,0,0,6">
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0" />
                <Button Grid.Column="2" Content="Show transcript" Command="{Binding ShowTranscriptCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0" />
              </Grid>
              <Button Classes="danger" Content="Stop gently…" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0" />
              <TextBlock Text="Stopping after the current step…" IsVisible="{Binding IsStopping}" Foreground="{DynamicResource NeedFg}" FontSize="12.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Classes="section" IsVisible="{Binding HasFiles}">
            <StackPanel>
              <TextBlock Text="{Binding FilesChanged.Count, StringFormat='Files changed · {0}'}" Classes="h2" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding FilesChanged}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FileVM">
                    <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,3" MinHeight="0" ToolTip.Tip="{Binding Path}"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.OpenFileCommand}" CommandParameter="{Binding}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Classes="mono" Foreground="{DynamicResource Blue}" />
                        <TextBlock Text="{Binding Name}" Classes="mono trim" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="section" IsVisible="{Binding HasSubagents}">
            <StackPanel>
              <TextBlock Text="Subagents" Classes="h2" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Subagents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SubagentVM">
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding Title}" FontSize="12.5" Classes="trim" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Text="{Binding Meta}" Classes="faint" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="section">
            <StackPanel>
              <TextBlock Text="Tools used" Classes="h2" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding ToolBars}" ItemTemplate="{StaticResource BarTemplate}" />
              <TextBlock Text="No tool calls yet." Classes="faint" IsVisible="{Binding !HasTools}" />
            </StackPanel>
          </Border>

          <Border Classes="section" IsVisible="{Binding HasMcp}">
            <StackPanel>
              <TextBlock Text="MCP servers and connectors" Classes="h2" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding McpBars}" ItemTemplate="{StaticResource BarTemplate}" />
            </StackPanel>
          </Border>

          <Border Classes="section">
            <StackPanel>
              <TextBlock Text="Skills used" Classes="h2" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding SkillsInvoked}" ItemTemplate="{StaticResource TextChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
              <TextBlock Text="None in this session." Classes="faint" IsVisible="{Binding !HasSkills}" />
              <TextBlock Text="{Binding SkillsAvailableTitle}" Classes="faint" Margin="0,4,0,0" ToolTip.Tip="{Binding SkillsAvailable.Count}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
