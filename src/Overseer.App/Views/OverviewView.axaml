<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Overseer.App.ViewModels"
             x:Class="Overseer.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <ScrollViewer>
    <StackPanel Margin="30,24,30,30">
      <TextBlock Text="Usage across all sessions" Classes="h1" />
      <TextBlock Text="Token counts come from your session logs, subagents included. Your plan's exact limits show below once Overseer's status line is on."
                 Classes="muted wrap" Margin="0,6,0,14" />

      <ItemsControl ItemsSource="{Binding Cards}" Margin="-7,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatCardVM">
            <Border Classes="card" ToolTip.Tip="{Binding Tip}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <Border Classes="iconbox" Background="{Binding IconBg}"><PathIcon Data="{Binding IconGeometry}" Foreground="{Binding IconBrush}" Width="12" Height="12" /></Border>
                  <TextBlock Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Big}" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Unit}" Classes="muted" />
                <ItemsControl ItemsSource="{Binding Spark}" ItemTemplate="{StaticResource ColumnTemplate}" ItemsPanel="{StaticResource RowPanelTemplate}" Height="32" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Line1}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" Margin="0,12,0,1" Classes="trim" />
                <TextBlock Text="{Binding Line2}" Classes="faint trim" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" Margin="0,7">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Shield}" Width="12" Height="12" Foreground="{DynamicResource Accent}" /></Border>
            <TextBlock Text="Plan limits" Classes="title" VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Limits}" IsVisible="{Binding HasLimits}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LimitVM">
                <StackPanel Margin="0,0,24,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Resets}" Classes="faint" VerticalAlignment="Bottom" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Percent}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                      <TextBlock Text="{Binding Title}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>
                  </DockPanel>
                  <ProgressBar Classes="bar" Height="8" Value="{Binding Fraction}" Foreground="{Binding Brush}" Margin="0,8,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding LimitsNote}" Classes="faint wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Border Classes="card" Margin="0,7">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Chart}" Width="12" Height="12" Foreground="{DynamicResource Accent}" /></Border>
            <TextBlock Text="Tokens per hour · last 24 hours" Classes="title" VerticalAlignment="Center" />
          </StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding HoursPeak}" Classes="faint" VerticalAlignment="Bottom" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding HoursTotal}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="tokens in 24h (excl. cache reads)" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource ColumnTemplate}" ItemsPanel="{StaticResource RowPanelTemplate}" Height="150" />
          <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource ColumnLabelTemplate}" ItemsPanel="{StaticResource RowPanelTemplate}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" Margin="-7,0">
        <StackPanel>
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Bulb}" Width="12" Height="12" Foreground="{DynamicResource Accent2}" /></Border>
                <TextBlock Text="Models · 7 days, by model calls" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Models}" ItemTemplate="{StaticResource BarTemplate}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Puzzle}" Width="12" Height="12" Foreground="{DynamicResource Purple}" /></Border>
                <TextBlock Text="MCP servers · 7 days" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Mcp}" ItemTemplate="{StaticResource BarTemplate}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Bolt}" Width="12" Height="12" Foreground="{DynamicResource Accent2}" /></Border>
                <TextBlock Text="Skills invoked · 7 days" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource BarTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Tool}" Width="12" Height="12" Foreground="{DynamicResource Blue}" /></Border>
                <TextBlock Text="Top tools · 7 days" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource BarTemplate}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Classes="iconbox"><PathIcon Data="{StaticResource Icon.Bolt}" Width="12" Height="12" Foreground="{DynamicResource Yellow}" /></Border>
                <TextBlock Text="{Binding InstalledSkillsTitle}" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding InstalledSkills}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
