<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Overseer.App.ViewModels"
             x:Class="Overseer.App.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <DockPanel Margin="30,24,30,0">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Search conversations" Classes="h1" />
      <TextBox Text="{Binding Query}" Watermark="Search prompts, replies and tool calls…" Margin="0,14,0,8" FontSize="14" Padding="12,9"
               AutomationProperties.Name="Search conversations" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Status}" Classes="muted" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,0,24">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchHitVM">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,10" Margin="0,0,0,6" FontWeight="Normal"
                    Command="{ReflectionBinding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding}">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Classes="faint" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding RoleBrush}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Classes="trim" />
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Snippet}" Classes="muted wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
