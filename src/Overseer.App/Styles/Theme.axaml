<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- A desktop-app look: system font at 13px, flat panes with 1px lines, small corner radii. -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ===== text ===== -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Margin" Value="0,12,0,6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBlock.wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.trim">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- hidden while "Hide private info" is on -->
  <Style Selector="ComboBox.private">
    <Setter Property="Effect"><BlurEffect Radius="8" /></Setter>
  </Style>
  <Style Selector="TextBlock.blur">
    <Setter Property="Effect"><BlurEffect Radius="8" /></Setter>
  </Style>

  <!-- ===== panes ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,12,14,14" />
    <Setter Property="Margin" Value="6" />
  </Style>
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource BgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.paneHead">
    <Setter Property="Background" Value="{DynamicResource BgSide}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Border.section">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.iconbox">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource BgCard2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2,8,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.note">
    <Setter Property="Background" Value="{DynamicResource BgSide}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,7,10,8" />
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource CodeBg}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.code TextBlock, Border.code SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CodeFg}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.need">
    <Setter Property="Background" Value="{DynamicResource BgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="4,1,1,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>

  <!-- ===== buttons ===== -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,4,10,5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryBg}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="ToggleButton:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="ToggleButton:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBg}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,4,12,5" />
  </Style>
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="Button.primary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource NeedFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NeedFg}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.flat, ToggleButton.flat">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- title bar / menu bar buttons -->
  <Style Selector="Button.bar, ToggleButton.bar">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <!-- sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,6,6,2" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="0,0,0,1" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.sessions ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===== segmented option pickers (ListBox, so they work with keyboard and screen readers) ===== -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource Track}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <!-- otherwise every picker drags the page to itself when its selection is set -->
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="Padding" Value="10,4,10,5" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCard}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #26000000" />
  </Style>
  <Style Selector="ListBox.small ListBoxItem">
    <Setter Property="Padding" Value="8,3,8,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ===== session list ===== -->
  <Style Selector="ListBox.sessions">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,0,6,8" />
  </Style>
  <Style Selector="ListBox.sessions ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===== inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource BgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource BgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="RadioButton, CheckBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="ProgressBar.bar">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Track}" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource BgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ===== the one animation: a soft pulse on sessions that need you ===== -->
  <Style Selector="Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
