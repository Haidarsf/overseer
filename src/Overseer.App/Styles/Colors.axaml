<!-- Overseer's palette: Claude's ivory / slate / clay, with olive and sky as quiet secondaries.
     Older key names (Blue, Green, Purple…) are kept so every view picks up the palette. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, SF Pro Text, -apple-system, Inter, Ubuntu, Cantarell, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, monospace</FontFamily>
  <FontFamily x:Key="SerifFont">Anthropic Serif, Georgia, Cambria, Times New Roman, serif</FontFamily>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgApp" Color="#FAF9F5" />
      <SolidColorBrush x:Key="BgSide" Color="#F0EEE6" />
      <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgCard2" Color="#F5F4EE" />
      <SolidColorBrush x:Key="BgHover" Color="#141F1E1D" />
      <SolidColorBrush x:Key="BgInput" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Sel" Color="#E8E6DC" />
      <SolidColorBrush x:Key="Track" Color="#E8E6DC" />
      <SolidColorBrush x:Key="Line" Color="#241F1E1D" />
      <SolidColorBrush x:Key="LineSoft" Color="#121F1E1D" />
      <SolidColorBrush x:Key="Fg" Color="#141413" />
      <SolidColorBrush x:Key="Fg2" Color="#3D3D3A" />
      <SolidColorBrush x:Key="Muted" Color="#5E5D59" />
      <SolidColorBrush x:Key="Faint" Color="#87867F" />
      <SolidColorBrush x:Key="Accent" Color="#D97757" />
      <SolidColorBrush x:Key="Accent2" Color="#A5502F" />
      <SolidColorBrush x:Key="AccentTint" Color="#1FD97757" />
      <SolidColorBrush x:Key="PrimaryBg" Color="#141413" />
      <SolidColorBrush x:Key="PrimaryHover" Color="#3D3D3A" />
      <SolidColorBrush x:Key="PrimaryFg" Color="#FAF9F5" />
      <SolidColorBrush x:Key="NeedBg" Color="#FBEFE8" />
      <SolidColorBrush x:Key="NeedFg" Color="#A5502F" />
      <SolidColorBrush x:Key="WorkFg" Color="#2F5E8C" />
      <SolidColorBrush x:Key="WorkDot" Color="#6A9BCC" />
      <SolidColorBrush x:Key="DoneDot" Color="#B0AEA5" />
      <SolidColorBrush x:Key="CodeBg" Color="#141413" />
      <SolidColorBrush x:Key="CodeFg" Color="#FAF9F5" />
      <SolidColorBrush x:Key="Overlay" Color="#61141413" />
      <SolidColorBrush x:Key="Green" Color="#5A6B43" />
      <SolidColorBrush x:Key="Blue" Color="#2F5E8C" />
      <SolidColorBrush x:Key="Red" Color="#B5462B" />
      <SolidColorBrush x:Key="Yellow" Color="#A5502F" />
      <SolidColorBrush x:Key="Purple" Color="#6E5C8A" />
      <SolidColorBrush x:Key="Teal" Color="#4F7C74" />
      <SolidColorBrush x:Key="Pink" Color="#9C5470" />
      <SolidColorBrush x:Key="Orange" Color="#B86534" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgApp" Color="#1F1E1D" />
      <SolidColorBrush x:Key="BgSide" Color="#181817" />
      <SolidColorBrush x:Key="BgCard" Color="#262624" />
      <SolidColorBrush x:Key="BgCard2" Color="#2B2A27" />
      <SolidColorBrush x:Key="BgHover" Color="#14FAF9F5" />
      <SolidColorBrush x:Key="BgInput" Color="#1A1918" />
      <SolidColorBrush x:Key="Sel" Color="#3D3D3A" />
      <SolidColorBrush x:Key="Track" Color="#3D3D3A" />
      <SolidColorBrush x:Key="Line" Color="#1FFAF9F5" />
      <SolidColorBrush x:Key="LineSoft" Color="#0FFAF9F5" />
      <SolidColorBrush x:Key="Fg" Color="#F0EEE6" />
      <SolidColorBrush x:Key="Fg2" Color="#C2C0B6" />
      <SolidColorBrush x:Key="Muted" Color="#9C9A92" />
      <SolidColorBrush x:Key="Faint" Color="#75736C" />
      <SolidColorBrush x:Key="Accent" Color="#D97757" />
      <SolidColorBrush x:Key="Accent2" Color="#E89A7C" />
      <SolidColorBrush x:Key="AccentTint" Color="#24D97757" />
      <SolidColorBrush x:Key="PrimaryBg" Color="#F0EEE6" />
      <SolidColorBrush x:Key="PrimaryHover" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PrimaryFg" Color="#141413" />
      <SolidColorBrush x:Key="NeedBg" Color="#1FD97757" />
      <SolidColorBrush x:Key="NeedFg" Color="#E89A7C" />
      <SolidColorBrush x:Key="WorkFg" Color="#9DC0E8" />
      <SolidColorBrush x:Key="WorkDot" Color="#6A9BCC" />
      <SolidColorBrush x:Key="DoneDot" Color="#75736C" />
      <SolidColorBrush x:Key="CodeBg" Color="#0E0E0D" />
      <SolidColorBrush x:Key="CodeFg" Color="#F0EEE6" />
      <SolidColorBrush x:Key="Overlay" Color="#80000000" />
      <SolidColorBrush x:Key="Green" Color="#A3B57F" />
      <SolidColorBrush x:Key="Blue" Color="#9DC0E8" />
      <SolidColorBrush x:Key="Red" Color="#E5806A" />
      <SolidColorBrush x:Key="Yellow" Color="#E89A7C" />
      <SolidColorBrush x:Key="Purple" Color="#B4A3CC" />
      <SolidColorBrush x:Key="Teal" Color="#8FBFB5" />
      <SolidColorBrush x:Key="Pink" Color="#D49AB0" />
      <SolidColorBrush x:Key="Orange" Color="#E0A070" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
