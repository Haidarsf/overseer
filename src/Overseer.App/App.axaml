<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Overseer.App.App"
             Name="Overseer"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Overseer/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://Overseer/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://Overseer/Styles/Templates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#D97757" RegionColor="#1F1E1D" AltHigh="#1F1E1D" BaseHigh="#F0EEE6" ChromeMediumLow="#262624" ChromeLow="#262624" />
        <ColorPaletteResources x:Key="Light" Accent="#C4633F" RegionColor="#FAF9F5" AltHigh="#FAF9F5" BaseHigh="#141413" ChromeMediumLow="#FFFFFF" ChromeLow="#F0EEE6" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Overseer/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
